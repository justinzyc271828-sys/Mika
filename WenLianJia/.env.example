# WenLianJia environment template.
# Copy to .env for development. In the desktop application, prefer the Settings
# page: secrets are then protected with Windows DPAPI and never written to .env.
#
# Never commit a real .env file.

# Optional: overrides the default data directory.
# WLJ_DATA_DIR=D:\WenLianJia_Data

# Optional bootstrap values. The GUI stores keys encrypted instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional Baidu Netdisk Open Platform application credentials.
BAIDU_APP_KEY=
BAIDU_APP_SECRET=
BAIDU_REDIRECT_URI=oob
